#!/bin/sh
# Reject commit messages with co-author trailers or tool/AI attribution.
msg_file="$1"

if grep -qiE '^co-authored-by:' "$msg_file"; then
  echo "error: commit message must not include Co-authored-by trailers" >&2
  exit 1
fi

if grep -qiE 'made with.*cursor|cursor\.com|generated by (claude|gpt|cursor|copilot|ai)|ai[- ]generated|ai[- ]assisted|written by (claude|gpt|cursor|copilot)' "$msg_file"; then
  echo "error: commit message must not include tool or AI attribution" >&2
  exit 1
fi
