# Copy to .env and fill in values (never commit .env)

DATABASE_URL=postgresql+psycopg://localhost/weekly_status

# Jira API authentication (operator token — not the person being collected)
JIRA_BASE_URL=https://redhat.atlassian.net
JIRA_API_TOKEN=
# JIRA_API_EMAIL=you@redhat.com   # optional if your email is in fixtures/eet-persons.json
# JIRA_EMAIL=                    # deprecated alias for JIRA_API_EMAIL
JIRA_PROJECTS=EET

# GitHub API authentication
GITHUB_TOKEN=
# GITHUB_LOGIN=          # deprecated; github_login comes from the person table
# GITHUB_MAX_COMMITS=100

# Claude / Slack
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# REPORT_CHANNEL_ID=

# Hosted skills: anthropic (default) or openai
# SKILL_PROVIDER=openai
# OPENAI_API_KEY=          # platform.openai.com key (not Granite/OpenAI-compatible proxies)
# OPENAI_BASE_URL=         # optional Granite/other OpenAI-compatible chat (not hosted skills)
# OPENAI_MODEL=            # optional model id for OPENAI_BASE_URL only
# OPENAI_SKILLS_BASE_URL=https://api.openai.com/v1
# OPENAI_SKILLS_MODEL=gpt-5.2

# Skills (fill in after `status skills publish --provider …`)
# DRAFTER_SKILL_ID=
# DRAFTER_SKILL_VERSION=latest
# SYNTHESIZER_SKILL_ID=
# SYNTHESIZER_SKILL_VERSION=latest
