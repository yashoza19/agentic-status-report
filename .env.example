# Copy to .env and fill in values (never commit .env)

DATABASE_URL=postgresql+psycopg://localhost/weekly_status

# Jira (Red Hat)
JIRA_BASE_URL=https://redhat.atlassian.net
JIRA_EMAIL=you@redhat.com
JIRA_API_TOKEN=
JIRA_ACCOUNT_ID=
JIRA_PROJECTS=EET

# GitHub
GITHUB_TOKEN=
GITHUB_LOGIN=

# Optional: scope PR search to specific repos (comma-separated)
# GITHUB_REPOS=owner/repo

# Claude / Slack
# ANTHROPIC_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# REPORT_CHANNEL_ID=

# Skills (fill in after publishing)
# DRAFTER_SKILL_ID=
# DRAFTER_SKILL_VERSION=latest
# SYNTHESIZER_SKILL_ID=
# SYNTHESIZER_SKILL_VERSION=latest
