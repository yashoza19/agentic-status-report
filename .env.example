# Copy to .env and fill in values (never commit .env)

DATABASE_URL=postgresql+psycopg://localhost/weekly_status

# Jira API authentication (operator token — not the person being collected)
JIRA_BASE_URL=https://redhat.atlassian.net
JIRA_API_TOKEN=
# JIRA_API_EMAIL=you@redhat.com   # optional if your email is in fixtures/eet-persons.json
# JIRA_EMAIL=                    # deprecated alias for JIRA_API_EMAIL
JIRA_PROJECTS=EET

# GitHub API authentication
GITHUB_TOKEN=
# GITHUB_LOGIN=          # deprecated; github_login comes from the person table
# GITHUB_MAX_COMMITS=100

# Claude / Slack
# ANTHROPIC_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# REPORT_CHANNEL_ID=

# Skill provider: anthropic (default) or gemini
# SKILL_PROVIDER=anthropic

# Skills (fill in after publishing)
# DRAFTER_SKILL_ID=
# DRAFTER_SKILL_VERSION=latest
# SYNTHESIZER_SKILL_ID=
# SYNTHESIZER_SKILL_VERSION=latest

# Gemini Skill Registry + Managed Agents (when SKILL_PROVIDER=gemini)
# GCP_PROJECT=
# GOOGLE_CLOUD_PROJECT=          # alternate for GCP_PROJECT
# GCP_LOCATION=us-central1       # Skill Registry region
# GCP_AGENTS_LOCATION=global
# GCP_INTERACTIONS_LOCATION=global
# GEMINI_BASE_AGENT=antigravity-preview-05-2026
# DRAFTER_AGENT_ID=weekly-status-drafter-agent
# SYNTHESIZER_AGENT_ID=weekly-status-synthesizer-agent
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json  # or use gcloud ADC
